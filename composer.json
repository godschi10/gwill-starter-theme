{
	"name": "gwillchijioke/gwill-starter-theme",
	"description": "GWill Starter — a custom WordPress starter theme. No parent theme dependency. Ships web push (self-hosted VAPID) and a custom-apps skeleton.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require": {
		"minishlink/web-push": "^11.0",
		"guzzlehttp/guzzle": "^7.8",
		"php-http/guzzle7-adapter": "^1.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
