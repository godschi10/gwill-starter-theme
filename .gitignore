# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# WordPress build artifacts
node_modules/
# ⚖️ LAW L1 (docs/LAWS.md): vendor/ is COMMITTED — NEVER exclude it.
# A bare `vendor/` line here silently strips the WebPush library from fresh
# clones (broken GitHub/GitLab download) and an unanchored rsync
# --exclude='vendor/' drops it from live deploys (require_once fatal).
*.log

# Compiled assets (if you use build tools)
dist/
build/
*.min.css
!assets/css/*.min.css

# Environment files
.env
.env.local
